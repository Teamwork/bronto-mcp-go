# Copy to .env and fill in. .env is gitignored; never commit a real API key.
#
# The server reads .env from its working directory at startup. Variables
# already set in the environment take precedence over this file. Keep to plain
# KEY=value lines so the same file works with `docker run --env-file .env`.

# Bronto API. BRONTO_API_KEY is required.
BRONTO_API_KEY=
BRONTO_API_ENDPOINT=https://api.eu.bronto.io

# Server. Uncomment to override the defaults.
# BRONTO_MCP_SERVER_ADDRESS=:8080
# BRONTO_MCP_LOG_LEVEL=info
# BRONTO_MCP_LOG_FORMAT=text
# BRONTO_MCP_ENV=dev
# BRONTO_MCP_SENTRY_DSN=
